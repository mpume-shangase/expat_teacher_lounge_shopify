<section class="etl-guides section-padding{% if section.settings.layout == 'chooser' %} etl-guides--chooser{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} style="background-color: {% if section.settings.tint %}#f9fafb{% else %}#ffffff{% endif %}; border-bottom: 1px solid #f0f0f5;">
<div class="container">
<div class="etl-guides__wrap">
<div class="etl-guides__head">
{%- if section.settings.eyebrow != blank -%}<span class="etl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
<h2 class="etl-heading">{{ section.settings.title_prefix }} <span class="etl-accent">{{ section.settings.title_italic }}</span></h2>
{%- if section.settings.subtitle != blank -%}<p class="etl-guides__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
</div>
{%- if section.settings.layout == 'chooser' -%}
<div class="etl-chooser">
<div class="etl-chooser__group">
<p class="etl-chooser__label">{{ section.settings.dest_label }}</p>
<div class="etl-chooser__pills">{%- render 'etl-guide-list', style: 'pill', group: 'destination' -%}</div>
</div>
<div class="etl-chooser__group">
<p class="etl-chooser__label">{{ section.settings.step_label }}</p>
<div class="etl-chooser__pills">{%- render 'etl-guide-list', style: 'pill', group: 'step' -%}</div>
</div>
</div>
{%- else -%}
<div class="etl-guides__grid">
{%- render 'etl-guide-list', style: 'cards', only: section.settings.only, exclude: request.path -%}
</div>
{%- endif -%}
</div>
{%- if section.settings.button_label != blank -%}
<div class="etl-guides__foot">{% render 'etl-button', label: section.settings.button_label, url: section.settings.button_url, class: 'btn btn-outline' %}</div>
{%- endif -%}
</div>
</section>
{% stylesheet %}
.etl-guides__head{max-width:760px;margin:0 auto 32px;text-align:center}
.etl-guides__sub{color:#475569;font-size:1.05rem;line-height:1.7;margin:14px auto 0;max-width:640px}
.etl-guides__grid{display:grid;grid-template-columns:1fr;gap:16px}
@media (min-width:750px){.etl-guides__grid{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1100px){.etl-guides__grid{grid-template-columns:repeat(3,1fr)}}
.etl-guides__card{display:flex;flex-direction:column;gap:6px;padding:20px 22px;background:#fff;border:1px solid #e2e8f0;border-radius:var(--border-radius-md,16px);text-decoration:none;color:inherit;transition:border-color .2s,box-shadow .2s,transform .2s}
.etl-guides__card:hover,.etl-guides__card:focus-visible{border-color:var(--color-blue);box-shadow:0 8px 24px rgba(15,23,42,.08);transform:translateY(-2px)}
.etl-guides__title{font-family:var(--font-display);font-weight:800;font-size:1.1rem;color:var(--text-light)}
.etl-guides__text{color:#475569;font-size:.95rem;line-height:1.55}
.etl-guides__more{margin-top:auto;padding-top:8px;color:var(--color-blue);font-weight:700;font-size:.9rem}
.etl-guides__foot{margin-top:28px;text-align:center}
.etl-guides__wrap{display:block}
.etl-guides--chooser{padding-top:56px;padding-bottom:56px}
.etl-guides--chooser .etl-guides__head{margin:0 0 24px;text-align:left;max-width:none}
.etl-guides--chooser .etl-heading{font-size:clamp(1.7rem,3.2vw,2.4rem);margin:6px 0 0}
.etl-guides--chooser .etl-guides__sub{margin:10px 0 0;font-size:1rem}
@media (min-width:990px){.etl-guides--chooser .etl-guides__wrap{display:grid;grid-template-columns:minmax(260px,1fr) 2fr;gap:56px;align-items:center}.etl-guides--chooser .etl-guides__head{margin:0}}
.etl-chooser{display:grid;gap:22px}
.etl-chooser__label{margin:0 0 10px;font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#64748b}
.etl-chooser__pills{display:flex;flex-wrap:wrap;gap:10px}
.etl-pill{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border:1px solid #dbe2ea;border-radius:999px;background:#fff;color:var(--text-light);font-weight:700;font-size:.95rem;line-height:1.2;text-decoration:none;transition:border-color .2s,color .2s,background-color .2s,box-shadow .2s}
.etl-pill__arrow{color:#94a3b8;transition:transform .2s,color .2s}
.etl-pill:hover,.etl-pill:focus-visible{border-color:var(--color-blue);color:var(--color-blue);box-shadow:0 4px 14px rgba(15,23,42,.06)}
.etl-pill:hover .etl-pill__arrow,.etl-pill:focus-visible .etl-pill__arrow{color:var(--color-blue);transform:translateX(3px)}
@media (max-width:749px){.etl-guides--chooser{padding-top:40px;padding-bottom:40px}.etl-chooser__pills{gap:8px}.etl-pill{padding:9px 14px;font-size:.88rem}.etl-guides--chooser .etl-guides__head{margin-bottom:18px}}
{% endstylesheet %}
{% schema %}
{
"name": "Guide links",
"settings": [
{ "type": "text", "id": "anchor", "label": "Anchor ID" },
{ "type": "text", "id": "eyebrow", "label": "Eyebrow" },
{ "type": "text", "id": "title_prefix", "label": "Heading", "default": "More free" },
{ "type": "text", "id": "title_italic", "label": "Italic heading words", "default": "guides." },
{ "type": "textarea", "id": "subtitle", "label": "Subheading" },
{ "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "cards", "label": "Cards with descriptions" }, { "value": "chooser", "label": "Compact chooser" } ], "default": "cards" },
{ "type": "text", "id": "dest_label", "label": "Chooser: destinations label", "default": "Where are you going?" },
{ "type": "text", "id": "step_label", "label": "Chooser: steps label", "default": "What are you working on?" },
{ "type": "text", "id": "only", "label": "Guides to show", "info": "Page handles separated by commas, in order. Leave blank to show all." },
{ "type": "text", "id": "button_label", "label": "Button (optional)" },
{ "type": "text", "id": "button_url", "label": "Button link" },
{ "type": "checkbox", "id": "tint", "label": "Light grey background", "default": false }
],
"presets": [{ "name": "Guide links" }]
}
{% endschema %}