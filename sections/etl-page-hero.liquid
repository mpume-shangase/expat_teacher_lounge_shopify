<section class="etl-page-hero"{% if section.settings.sticky_trigger %} data-etl-sticky-trigger{% endif %}>
  <div class="etl-page-hero__bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: '' }}
    {%- else -%}
      <img src="{{ section.settings.image_asset | default: 'Edwina_delivering_a_presentation.png' | asset_img_url: '1600x' }}" alt="" loading="eager">
    {%- endif -%}
  </div>
  <div class="etl-page-hero__dark"></div>
  <div class="etl-page-hero__fade"></div>
  <div class="etl-page-hero__content">
    {%- if section.settings.brand_logo_asset != blank -%}<div class="etl-brand-chip"><span class="etl-brand-chip__mark"><img src="{{ section.settings.brand_logo_asset | asset_url }}" alt="" width="30" height="26" loading="eager"></span><span class="etl-brand-chip__text"><span class="etl-brand-chip__name">{{ section.settings.brand_name | default: 'Teacher Moves' }}</span>{%- if section.settings.brand_sub != blank -%}<span class="etl-brand-chip__sub">{{ section.settings.brand_sub }}</span>{%- endif -%}</span></div>{%- endif -%}{%- if section.settings.badge != blank -%}<div class="hero-pill" style="margin: 0 auto 24px;">{{ section.settings.badge }}</div>{%- endif -%}
    <h1 class="etl-page-hero__title">{{ section.settings.title_prefix }} <span>{{ section.settings.title_italic }}</span></h1>
    {%- if section.settings.description != blank -%}<p class="etl-page-hero__desc">{{ section.settings.description }}</p>{%- endif -%}
    {%- if section.settings.price != blank -%}<p class="etl-page-hero__price">{{ section.settings.price }}</p>{%- endif -%}
    <div class="etl-btn-row">
      {%- if section.settings.buy_product != blank -%}
        {% render 'etl-buy-form', product: section.settings.buy_product, label: section.settings.cta_1_text, class: 'btn btn-primary', form_id: 'etl-hero-buy' %}
      {%- else -%}
        {% render 'etl-button', label: section.settings.cta_1_text, url: section.settings.cta_1_url, class: 'btn btn-primary' %}
      {%- endif -%}
      {% render 'etl-button', label: section.settings.cta_2_text, url: section.settings.cta_2_url, class: 'btn btn-secondary' %}
    </div>
    {%- if section.settings.note != blank -%}<p class="etl-page-hero__note">{{ section.settings.note }}</p>{%- endif -%}
{%- if section.settings.proof_quote != blank -%}
<figure class="etl-hero-proof">
<p class="etl-hero-proof__kind">{% if section.settings.proof_kind == 'ask' %}A question teachers ask us{% else %}What a teacher said{% endif %} &middot; {{ section.settings.proof_platform }}</p>
<blockquote class="etl-hero-proof__quote">{{ section.settings.proof_quote | escape }}</blockquote>
<figcaption class="etl-hero-proof__cap">{{ section.settings.proof_name | escape }}{% if section.settings.proof_url != blank %} &middot; <a href="{{ section.settings.proof_url | escape }}" target="_blank" rel="noopener nofollow">{% if section.settings.proof_url contains 'lc=' %}View the comment{% else %}View the video{% endif %}</a>{% endif %}</figcaption>
</figure>
{%- endif -%}
  </div>
</section>
{% stylesheet %}.etl-brand-chip{display:flex;align-items:center;gap:12px;width:fit-content;max-width:100%;margin:0 auto 22px;padding:6px 20px 6px 6px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);text-align:left}.etl-brand-chip__mark{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.28)}.etl-brand-chip__mark img{width:30px;height:auto;display:block}.etl-brand-chip__text{display:flex;flex-direction:column;line-height:1.15}.etl-brand-chip__name{font-family:var(--font-body);font-weight:800;font-size:14px;letter-spacing:.16em;text-transform:uppercase;color:#fff}.etl-brand-chip__sub{font-family:var(--font-body);font-size:11px;letter-spacing:.04em;color:rgba(255,255,255,.72);margin-top:3px}.etl-hero-proof{max-width:560px;margin:28px auto 0;padding:16px 20px;border-radius:16px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);text-align:left}.etl-hero-proof__kind{margin:0 0 6px;font-family:var(--font-body);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.72)}.etl-hero-proof__quote{margin:0;padding:0;border:0;font-size:15px;line-height:1.6;color:#fff;white-space:pre-line;overflow-wrap:anywhere}.etl-hero-proof__cap{margin:8px 0 0;font-size:13px;color:rgba(255,255,255,.75)}.etl-hero-proof__cap a{color:#fff;text-decoration:underline;text-underline-offset:3px}{% endstylesheet %}{% schema %}
{
  "name": "Page hero (dark)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_asset", "label": "Theme image used when no image is picked", "default": "Edwina_delivering_a_presentation.png" },
    { "type": "text", "id": "brand_logo_asset", "label": "Brand logo (theme asset file)", "info": "For example tm-mark.svg. Leave blank to hide the brand chip." }, { "type": "text", "id": "brand_name", "label": "Brand name in the chip", "default": "Teacher Moves" }, { "type": "text", "id": "brand_sub", "label": "Small line under the brand name" }, { "type": "text", "id": "badge", "label": "Badge pill" },
    { "type": "text", "id": "title_prefix", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "title_italic", "label": "Gold italic words" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "price", "label": "Price line" },
    { "type": "text", "id": "cta_1_text", "label": "Primary button" },
    { "type": "text", "id": "cta_1_url", "label": "Primary link" },
    { "type": "product", "id": "buy_product", "label": "Buy product (primary goes straight to checkout)" },
    { "type": "text", "id": "cta_2_text", "label": "Secondary button" },
    { "type": "text", "id": "cta_2_url", "label": "Secondary link" },
    { "type": "text", "id": "note", "label": "Small note" },
    { "type": "checkbox", "id": "sticky_trigger", "label": "Show the mobile sticky button after this hero", "default": false },
{ "type": "header", "content": "Comment under the buttons" },
{ "type": "select", "id": "proof_kind", "label": "Type", "options": [ { "value": "say", "label": "What a teacher said" }, { "value": "ask", "label": "A question teachers ask us" } ], "default": "say" },
{ "type": "textarea", "id": "proof_quote", "label": "Comment, word for word", "info": "Leave blank to hide." },
{ "type": "text", "id": "proof_name", "label": "Name as shown publicly" },
{ "type": "select", "id": "proof_platform", "label": "Platform", "options": [ { "value": "YouTube", "label": "YouTube" }, { "value": "TikTok", "label": "TikTok" } ], "default": "YouTube" },
{ "type": "text", "id": "proof_url", "label": "Link to the comment or video" }
  ],
  "presets": [{ "name": "Page hero (dark)" }]
}
{% endschema %}
