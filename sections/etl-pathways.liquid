{%- assign cols = section.blocks.size | at_most: 4 -%}
<section class="section-padding bg-light text-light"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} style="background-color: {% if section.settings.tint %}#f9fafb{% else %}#ffffff{% endif %}; border-bottom: 1px solid #f0f0f5;">
  <div class="container">
    <div style="margin-bottom: 48px;">
      {%- if section.settings.eyebrow != blank -%}<span class="etl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="etl-heading">{{ section.settings.title_prefix }} <span class="etl-accent">{{ section.settings.title_italic }}</span></h2>
      {%- if section.settings.subtitle != blank -%}<p class="etl-sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
    <div class="grid grid-cols-1 grid-cols-{{ cols | at_least: 2 }}" style="gap: 24px;">
      {%- for block in section.blocks -%}
        <div class="etl-card{% if block.settings.featured %} etl-card--featured{% endif %}" {{ block.shopify_attributes }}>
          <div class="etl-card__accent"></div>
          {%- if block.settings.icon != 'none' -%}
            <span class="etl-card__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'canada' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.6 3.2 2.2-1-.6 4 2.6-1.4.6 1.8 2.6-.4-1 3 1 1.2-4.6 3.4.5 2.2-4.6-.6V22h-1.4v-3.6l-4.6.6.5-2.2L2.6 13.4l1-1.2-1-3 2.6.4.6-1.8 2.6 1.4-.6-4 2.2 1z"/></svg>
                {%- when 'globe' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
                {%- when 'contract' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
                {%- when 'community' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.6"/><path d="M15.5 14.2c3 .2 5.5 2.6 5.5 5.8"/></svg>
                {%- when 'book' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M4 21V5M8 7h6"/></svg>
                {%- when 'compass' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
          {%- if block.settings.kicker != blank -%}<span class="etl-card__kicker">{{ block.settings.kicker }}</span>{%- endif -%}
          <h3 class="etl-card__title">{{ block.settings.title }}</h3>
          {%- if block.settings.price != blank -%}<span class="etl-card__price">{{ block.settings.price }}</span>{%- endif -%}
          <div class="etl-card__text">{{ block.settings.text }}</div>
          {%- assign bcls = 'btn btn-outline btn-sm' -%}{%- if block.settings.featured -%}{%- assign bcls = 'btn btn-primary btn-sm' -%}{%- endif -%}
          {% render 'etl-button', label: block.settings.button_label, url: block.settings.button_url, class: bcls %}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div style="margin-top: 40px;">{% render 'etl-button', label: section.settings.button_label, url: section.settings.button_url, class: 'btn btn-outline' %}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Pathway cards",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID (for #links)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title_prefix", "label": "Heading", "default": "What's your" },
    { "type": "text", "id": "title_italic", "label": "Italic heading words", "default": "next move?" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "checkbox", "id": "tint", "label": "Light grey background", "default": false },
    { "type": "text", "id": "button_label", "label": "Button under cards (optional)" },
    { "type": "text", "id": "button_url", "label": "Button link" }
  ],
  "blocks": [{ "type": "card", "name": "Card", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [
      { "value": "none", "label": "None" }, { "value": "canada", "label": "Canada" }, { "value": "globe", "label": "Globe" }, { "value": "contract", "label": "Contract" },
      { "value": "community", "label": "Community" }, { "value": "book", "label": "Book" }, { "value": "compass", "label": "Compass" } ] },
    { "type": "text", "id": "kicker", "label": "Small label" },
    { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
    { "type": "text", "id": "price", "label": "Price (optional)" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short description.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "featured", "label": "Featured", "default": false } ] }],
  "presets": [{ "name": "Pathway cards", "blocks": [{ "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
