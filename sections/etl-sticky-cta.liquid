{%- if section.settings.buy_product != blank or section.settings.url != blank -%}
<div class="etl-sticky" data-etl-sticky>
  {%- if section.settings.buy_product != blank -%}
    {% render 'etl-buy-form', product: section.settings.buy_product, label: section.settings.label, class: 'btn btn-primary', form_id: 'etl-sticky-buy' %}
  {%- else -%}
    {% render 'etl-button', label: section.settings.label, url: section.settings.url, class: 'btn btn-primary' %}
  {%- endif -%}
</div>
<script>
  (function () {
    var bar = document.querySelector('[data-etl-sticky]');
    var trigger = document.querySelector('[data-etl-sticky-trigger]');
    if (!bar || !trigger || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (e) {
      bar.classList.toggle('is-visible', !e[0].isIntersecting && e[0].boundingClientRect.top < 0);
    }).observe(trigger);
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Mobile sticky button",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Start My Canada Pathway — $197" },
    { "type": "product", "id": "buy_product", "label": "Buy product (straight to checkout)" },
    { "type": "text", "id": "url", "label": "Link (used if no product)" }
  ],
  "presets": [{ "name": "Mobile sticky button" }]
}
{% endschema %}
