<footer class="tm-footer" role="contentinfo">
  <div class="tm-container">
    <div class="tm-footer__grid">
      <div class="tm-footer__brand">
        <a href="{{ routes.root_url }}" class="tm-logo" aria-label="Teacher Moves home">
          {% render 'tm-logo-mark', tone: 'light' %}
          <span class="tm-logo__text"><span class="tm-logo__name" style="color:#fff">Teacher Moves</span><span class="tm-logo__sub" style="color:#8C98AE">by Expat Teacher's Lounge</span></span>
        </a>
        <p style="margin:0;line-height:1.6">{{ section.settings.statement }}</p>
        {%- assign yt = section.settings.youtube_url -%}
        {%- assign ig = section.settings.instagram_url -%}
        {%- assign tt = section.settings.tiktok_url -%}
        {%- if yt != blank or ig != blank or tt != blank -%}
          <div class="tm-footer__social">
            {%- if yt != blank -%}<a href="{{ yt }}" target="_blank" rel="noopener" aria-label="YouTube (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9l5.8 3.1-5.8 3.1z"/></svg></a>{%- endif -%}
            {%- if ig != blank -%}<a href="{{ ig }}" target="_blank" rel="noopener" aria-label="Instagram (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 4.7a5.1 5.1 0 1 0 0 10.2 5.1 5.1 0 0 0 0-10.2zm0 8.4a3.3 3.3 0 1 1 0-6.6 3.3 3.3 0 0 1 0 6.6zm5.3-9.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg></a>{%- endif -%}
            {%- if tt != blank -%}<a href="{{ tt }}" target="_blank" rel="noopener" aria-label="TikTok (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 3c.4 2.1 1.7 3.6 3.9 3.9v3.2a7.4 7.4 0 0 1-3.9-1.2v6.3c0 3.3-2.4 5.8-5.7 5.8a5.7 5.7 0 0 1-1-11.3v3.3a2.5 2.5 0 1 0 1.8 2.4V3h4.9z"/></svg></a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <details class="tm-footer__col" open data-tm-footer-col>
        <summary class="tm-footer__title">Explore</summary>
        <ul class="tm-footer__list">
          <li><a href="/pages/community">Community</a></li>
          <li><a href="/pages/teach-in-canada">Teach in Canada</a></li>
          <li><a href="/pages/resources">Resources</a></li>
          <li><a href="/pages/services">Services</a></li>
          <li><a href="/pages/about">About</a></li>
        </ul>
      </details>

      <details class="tm-footer__col" open data-tm-footer-col>
        <summary class="tm-footer__title">Services</summary>
        <ul class="tm-footer__list">
          <li><a href="/pages/canada-teacher-pathway">Canada Teacher Pathway Assessment</a></li>
          <li><a href="/products/relocation-strategy-session">Relocation Strategy</a></li>
          <li><a href="/products/contract-review-session">Contract Review</a></li>
        </ul>
      </details>

      <details class="tm-footer__col" open data-tm-footer-col>
        <summary class="tm-footer__title">Resources</summary>
        <ul class="tm-footer__list">
          <li><a href="/pages/resources#international">International Teaching</a></li>
          <li><a href="/pages/resources#canada">Canada</a></li>
          <li><a href="/blogs/news">Insights</a></li>
          <li><a href="/pages/resources#free">Free Resources</a></li>
        </ul>
      </details>

      <details class="tm-footer__col" open data-tm-footer-col>
        <summary class="tm-footer__title">Legal</summary>
        <ul class="tm-footer__list">
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms-and-conditions">Terms</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
          <li><a href="/pages/disclaimer">Disclaimer</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </details>
    </div>

    <div class="tm-footer__news">
      <div style="display:flex;flex-direction:column;gap:6px;max-width:460px">
        <h2 class="tm-footer__title" style="margin:0;font-size:1.1rem">Teacher Moves insights, by email</h2>
        <p style="margin:0;color:#8C98AE;font-size:.92rem">Certification updates, contract tips and new resources. No spam; unsubscribe any time.</p>
      </div>
      {%- form 'customer', id: 'tm-footer-newsletter', class: 'tm-footer__news-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="tm-form-msg tm-form-msg--ok" role="status" style="margin:0">Thanks, you're subscribed.</p>
        {%- else -%}
          <label for="tm-footer-email" class="tm-sr">Email address</label>
          <input id="tm-footer-email" type="email" name="contact[email]" autocomplete="email" placeholder="Your email address" required>
          <button type="submit" class="tm-btn tm-btn--light">Subscribe</button>
          {%- if form.errors -%}<p class="tm-form-msg tm-form-msg--err" role="alert" style="margin:0;flex-basis:100%">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="tm-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} Expat Teacher's Lounge · <a href="mailto:info@expatteacherslounge.com">info@expatteacherslounge.com</a></span>
      <span><a href="/pages/data-sharing-opt-out">Your privacy choices</a></span>
    </div>
    {%- if section.settings.disclaimer != blank -%}
      <p style="margin:16px 0 0;font-size:.8rem;color:#6F7C94;line-height:1.55">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "statement", "label": "Brand statement", "default": "Helping teachers make confident career moves across borders and beyond." },
    { "type": "header", "content": "Social links (leave empty to hide)" },
    { "type": "text", "id": "youtube_url", "label": "YouTube URL", "default": "https://www.youtube.com/@expatteacherslounge" },
    { "type": "text", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "text", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "textarea", "id": "disclaimer", "label": "Affiliate disclosure" }
  ]
}
{% endschema %}
