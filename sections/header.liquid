{%- liquid
  assign main_menu = linklists[section.settings.menu]
  assign join_url = section.settings.join_url | default: 'https://www.skool.com/expat-teachers-lounge-9615/about'
  assign join_label = section.settings.join_label | default: 'Join Free'
-%}

<header class="tm-header" role="banner">
  <div class="tm-container tm-header__inner">
    <a href="{{ routes.root_url }}" class="tm-logo" aria-label="Teacher Moves by Expat Teacher's Lounge, home">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" style="max-width: {{ section.settings.logo_max_width }}px;">
      {%- else -%}
        {% render 'tm-logo-mark' %}
        <span class="tm-logo__text">
          <span class="tm-logo__name">{{ section.settings.brand_name | default: 'Teacher Moves' }}</span>
          <span class="tm-logo__sub">{{ section.settings.brand_sub | default: "by Expat Teacher's Lounge" }}</span>
        </span>
      {%- endif -%}
    </a>

    <nav class="tm-nav" aria-label="Main">
      {%- if main_menu.links.size > 0 -%}
        {%- for link in main_menu.links -%}
          <a href="{{ link.url }}" class="tm-nav__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/" class="tm-nav__link"{% if request.path == '/' %} aria-current="page"{% endif %}>Home</a>
        <a href="/pages/community" class="tm-nav__link"{% if request.path == '/pages/community' %} aria-current="page"{% endif %}>Community</a>
        <a href="/pages/teach-in-canada" class="tm-nav__link"{% if request.path == '/pages/teach-in-canada' %} aria-current="page"{% endif %}>Teach in Canada</a>
        <a href="/pages/resources" class="tm-nav__link"{% if request.path == '/pages/resources' %} aria-current="page"{% endif %}>Resources</a>
        <a href="/pages/services" class="tm-nav__link"{% if request.path == '/pages/services' %} aria-current="page"{% endif %}>Services</a>
        <a href="/pages/about" class="tm-nav__link"{% if request.path == '/pages/about' %} aria-current="page"{% endif %}>About</a>
      {%- endif -%}
    </nav>

    <div class="tm-header__actions">
      {% render 'tm-button', label: join_label, url: join_url, style: 'primary', size: 'sm', extra_class: 'tm-header__join' %}
      {%- if cart.item_count > 0 -%}
        <a href="{{ routes.cart_url }}" class="tm-icon-btn" aria-label="Cart, {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="tm-cart-count">{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
      <button type="button" class="tm-icon-btn tm-menu-toggle" data-tm-menu-toggle aria-controls="tm-drawer" aria-expanded="false" aria-label="Open menu">
        <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
      </button>
    </div>
  </div>

  <div class="tm-drawer" id="tm-drawer">
    <nav class="tm-drawer__nav" aria-label="Mobile">
      {%- if main_menu.links.size > 0 -%}
        {%- for link in main_menu.links -%}
          <a href="{{ link.url }}" class="tm-drawer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/" class="tm-drawer__link">Home</a>
        <a href="/pages/community" class="tm-drawer__link">Community</a>
        <a href="/pages/teach-in-canada" class="tm-drawer__link">Teach in Canada</a>
        <a href="/pages/resources" class="tm-drawer__link">Resources</a>
        <a href="/pages/services" class="tm-drawer__link">Services</a>
        <a href="/pages/about" class="tm-drawer__link">About</a>
      {%- endif -%}
      {% render 'tm-button', label: join_label, url: join_url, style: 'primary', block: true %}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)", "info": "Leave empty to use the Teacher Moves lockup below." },
    { "type": "range", "id": "logo_max_width", "min": 80, "max": 300, "step": 10, "unit": "px", "label": "Logo image width", "default": 180 },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Teacher Moves" },
    { "type": "text", "id": "brand_sub", "label": "Brand subline", "default": "by Expat Teacher's Lounge" },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Leave empty to use the default: Home, Community, Teach in Canada, Resources, Services, About." },
    { "type": "header", "content": "Join button" },
    { "type": "text", "id": "join_label", "label": "Label", "default": "Join Free" },
    { "type": "text", "id": "join_url", "label": "Link", "default": "https://www.skool.com/expat-teachers-lounge-9615/about" }
  ]
}
{% endschema %}
