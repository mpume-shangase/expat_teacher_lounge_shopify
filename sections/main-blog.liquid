{%- paginate blog.articles by 6 -%}

<!-- Blog Page Hero -->
<section class="relative flex items-center justify-center overflow-hidden" id="blog-hero-{{ section.id }}" style="height: 60vh; min-height: 480px; background-color: #0a0b14; color: #ffffff;">
  
  <style>
    #blog-hero-{{ section.id }} h1 {
      color: #ffffff !important;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5) !important;
    }
    #blog-hero-{{ section.id }} p {
      color: rgba(255, 255, 255, 0.85) !important;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5) !important;
    }
  </style>

  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    {%- if section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" 
           alt="The Lounge Blog Hero" 
           style="width: 100%; height: 100%; object-fit: cover; object-position: center;"
           loading="eager">
    {%- else -%}
      <!-- Default fallback background image -->
      <img src="{{ 'Edwina_reading_a_book.png' | asset_url }}" 
           alt="The Lounge Blog Hero Fallback" 
           style="width: 100%; height: 100%; object-fit: cover; object-position: center;"
           loading="eager">
    {%- endif -%}
    
    <!-- Dark gradient overlay to ensure legibility and seamless white bottom transition -->
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10, 11, 20, 0.95) 0%, rgba(10, 11, 20, 0.7) 50%, var(--bg-light, #ffffff) 100%); z-index: 1;"></div>
  </div>

  <!-- Hero Content -->
  <div class="container relative z-10" style="margin-top: 80px; text-align: center; width: 100%;">
    <h1 class="font-display font-black" style="font-size: clamp(2.5rem, 6vw, 4.5rem); margin-bottom: 24px; line-height: 1.1; color: #ffffff;">
      {{ section.settings.hero_title_prefix }} <span class="italic" style="color: #FCCB52; font-style: italic;">{{ section.settings.hero_title_gold }}</span>
    </h1>
    <p style="font-size: clamp(1.1rem, 2.5vw, 1.45rem); max-width: 650px; margin-left: auto; margin-right: auto; line-height: 1.5;">
      {{ section.settings.hero_description }}
    </p>
  </div>

</section>

<!-- Categories Filter Bar at the Top -->
<section class="bg-light" style="padding-top: 40px; padding-bottom: 20px; background-color: var(--bg-light); border-bottom: 1px solid #e2e8f0;">
  <div class="container">
    <div class="blog-categories-bar" style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
      <a href="{{ blog.url }}" class="blog-category-btn {% unless current_tags %}active{% endunless %}" style="padding: 10px 24px; border-radius: var(--border-radius-full); font-weight: 700; font-size: 0.9rem; transition: var(--transition-smooth); background-color: #fafafc; border: 1px solid #e2e8f0; color: #475569;">
        All Articles
      </a>
      {%- if blog.all_tags.size > 0 -%}
        {%- for tag in blog.all_tags -%}
          {%- assign is_active = false -%}
          {%- if current_tags contains tag -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="blog-category-btn {% if is_active %}active{% endif %}" style="padding: 10px 24px; border-radius: var(--border-radius-full); font-weight: 700; font-size: 0.9rem; transition: var(--transition-smooth); background-color: #fafafc; border: 1px solid #e2e8f0; color: #475569;">
            {{ tag | capitalize }}
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign placeholder_tags = "Qatar,UAE,Contracts,Recruitment,Interviews" | split: "," -%}
        {%- for tag in placeholder_tags -%}
          <span class="blog-category-btn" style="padding: 10px 24px; border-radius: var(--border-radius-full); font-weight: 700; font-size: 0.9rem; transition: var(--transition-smooth); background-color: #fafafc; border: 1px solid #e2e8f0; color: #888899; cursor: not-allowed;">
            {{ tag }}
          </span>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<!-- Blog Listing Page Content -->
<section class="section-padding bg-light text-light" style="padding-top: 60px; padding-bottom: 120px; background-color: var(--bg-light);">
  <div class="container">
    
    <!-- 3-Column Grid Layout -->
    <div class="blog-grid-layout" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; width: 100%;">
      {%- for article in blog.articles -%}
        <article class="blog-grid-card group" style="display: flex; flex-direction: column; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: var(--border-radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); transition: var(--transition-smooth); height: 100%;">
          
          <a href="{{ article.url }}" style="display: flex; flex-direction: column; height: 100%; width: 100%;">
            <!-- Inset Article Image -->
            <div class="blog-grid-card-image" style="width: 100%; aspect-ratio: 16/10; overflow: hidden; background-color: #f3f4f6; position: relative; border-bottom: 1px solid #e5e7eb;">
              {%- if article.image != blank -%}
                <img src="{{ article.image | image_url: width: 600 }}" 
                     alt="{{ article.title | escape }}" 
                     style="width: 100%; height: 100%; object-fit: cover; transition: var(--transition-smooth);"
                     class="blog-card-img"
                     loading="lazy">
              {%- else -%}
                <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);"></div>
              {%- endif -%}
            </div>

            <!-- Card Content -->
            <div class="blog-grid-card-body" style="display: flex; flex-direction: column; padding: 28px; flex-grow: 1; justify-content: space-between; gap: 20px;">
              <div>
                <!-- Tag / Category Badge -->
                {%- if article.tags.size > 0 -%}
                  <span class="blog-tag-badge" style="background-color: rgba(28, 145, 215, 0.08); color: var(--color-blue); padding: 4px 10px; border-radius: var(--border-radius-full); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; align-self: flex-start; margin-bottom: 12px; display: inline-block; letter-spacing: 0.05em; font-family: var(--font-body);">
                    {{ article.tags.first }}
                  </span>
                {%- endif -%}

                <!-- Title -->
                <h3 class="font-display font-bold blog-card-title" style="font-size: 1.25rem; line-height: 1.4; color: var(--text-light); margin-top: 0; margin-bottom: 12px; transition: var(--transition-smooth); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3.5rem;">
                  {{ article.title }}
                </h3>

                <!-- Excerpt -->
                <p class="blog-card-excerpt" style="color: #64748b; font-size: 0.9rem; line-height: 1.6; margin-bottom: 0; font-family: var(--font-body); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html }}
                  {%- else -%}
                    {{ article.content | strip_html }}
                  {%- endif -%}
                </p>
              </div>

              <!-- Meta Info (Author & Read Time) -->
              <div style="font-size: 0.8rem; color: #888899; display: flex; align-items: center; gap: 8px; border-top: 1px solid #f1f5f9; padding-top: 16px; font-family: var(--font-body);">
                <span>{{ article.author }}</span>
                <span>&bull;</span>
                {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
                {%- assign read_time = word_count | divided_by: 200 | plus: 1 -%}
                <span>{{ read_time }} min read</span>
              </div>

            </div>
          </a>

        </article>
      {%- else -%}
        <div style="text-align: center; padding: 64px 0; color: #888899; grid-column: 1 / -1;">
          No articles found in this blog.
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <div style="display: flex; justify-content: center; gap: 16px; align-items: center; border-top: 1px solid #e5e7eb; padding-top: 32px; font-size: 0.95rem; margin-top: 48px;">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" style="color: var(--color-blue); font-weight: 700;">&larr; Previous</a>
        {%- endif -%}
        
        <span style="color: #64748b;">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>

        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" style="color: var(--color-blue); font-weight: 700;">Next &rarr;</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<!-- Custom Self-contained CSS Styles for the Blog Grid -->
<style>
  .blog-category-btn:hover {
    border-color: var(--color-blue) !important;
    color: var(--color-blue) !important;
    transform: translateY(-1px);
  }
  .blog-category-btn.active {
    background-color: var(--color-blue) !important;
    border-color: var(--color-blue) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 12px rgba(28, 145, 215, 0.25);
  }
  .blog-grid-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-blue) !important;
    box-shadow: var(--shadow-md) !important;
  }
  .blog-grid-card:hover .blog-card-title {
    color: var(--color-blue) !important;
  }
  .blog-grid-card:hover .blog-card-img {
    transform: scale(1.03);
  }
</style>

{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "hero_title_prefix",
      "label": "Hero Title Prefix",
      "default": "The"
    },
    {
      "type": "text",
      "id": "hero_title_gold",
      "label": "Hero Title Gold",
      "default": "Lounge."
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Real stories and hard data from the international teaching circuit."
    }
  ]
}
{% endschema %}
