<section class="etl-textpage">
  <div class="etl-textpage__hero">
    <div class="etl-textpage__wrap">
      {%- if section.settings.eyebrow != blank -%}<span class="etl-textpage__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="etl-textpage__title">{{ page.title }}</h1>
    </div>
  </div>
  <div class="etl-textpage__wrap">
    <div class="etl-textpage__card rte">
      {{ page.content }}
    </div>
    {%- if section.settings.show_cta -%}
      <div class="etl-textpage__cta">
        <p>{{ section.settings.cta_lead }}</p>
        <a class="btn btn-primary" href="{{ section.settings.cta_url | default: '/pages/teacher-moves-assessment' }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
.etl-textpage { background: #fff; padding-bottom: 96px; }
.etl-textpage__wrap { max-width: 840px; margin: 0 auto; padding: 0 24px; }
.etl-textpage__hero { padding: 150px 0 120px; background: radial-gradient(120% 140% at 0% 0%, rgba(28, 145, 215, .14) 0%, rgba(28, 145, 215, 0) 55%), radial-gradient(90% 120% at 100% 0%, rgba(252, 203, 82, .18) 0%, rgba(252, 203, 82, 0) 55%), #f5f7fb; border-bottom: 1px solid #e5e8f0; }
.etl-textpage__eyebrow { display: block; margin-bottom: 14px; font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-brand-blue, #1C91D7); }
.etl-textpage__title { margin: 0; font-family: var(--font-display, "Fraunces", Georgia, serif); font-weight: 900; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.1; color: #0a0a14; }
.etl-textpage__card { position: relative; margin-top: -72px; padding: 48px 52px; background: #fff; border: 1px solid #e5e8f0; border-radius: 24px; box-shadow: 0 30px 60px -36px rgba(20, 61, 138, .35); font-size: 1.05rem; line-height: 1.75; color: #3f4654; }
.etl-textpage__card > :first-child { margin-top: 0; }
.etl-textpage__card > :last-child { margin-bottom: 0; }
.etl-textpage__card p { margin: 0 0 16px; }
.etl-textpage__card h2, .etl-textpage__card h3, .etl-textpage__card h4 { margin: 36px 0 12px; font-family: var(--font-display, "Fraunces", Georgia, serif); font-weight: 800; line-height: 1.25; color: #0a0a14; }
.etl-textpage__card h2 { font-size: 1.6rem; }
.etl-textpage__card h3 { font-size: 1.3rem; }
.etl-textpage__card h4 { font-size: 1.1rem; }
.etl-textpage__card ul, .etl-textpage__card ol { margin: 0 0 18px; padding-left: 22px; }
.etl-textpage__card li { margin-bottom: 8px; }
.etl-textpage__card a { color: var(--color-brand-deep, #143D8A); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
.etl-textpage__card strong { color: #0a0a14; }
.etl-textpage__card hr { margin: 32px 0; border: 0; border-top: 1px solid #e5e8f0; }
.etl-textpage__cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-top: 28px; padding: 24px 28px; border-radius: 20px; background: var(--color-brand-deep, #143D8A); color: #fff; }
.etl-textpage__cta p { margin: 0; font-size: 1.05rem; font-weight: 600; }
@media (max-width: 749px) {
  .etl-textpage__hero { padding: 120px 0 96px; }
  .etl-textpage__card { margin-top: -56px; padding: 28px 22px; border-radius: 20px; font-size: 1rem; }
  .etl-textpage__cta { flex-direction: column; align-items: stretch; text-align: center; }
}
</style>

{% schema %}
{
  "name": "Page Content",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above the title", "default": "Expat Teacher's Lounge" },
    { "type": "checkbox", "id": "show_cta", "label": "Show assessment strip under the content", "default": true },
    { "type": "text", "id": "cta_lead", "label": "Strip text", "default": "Not sure what your next step is?" },
    { "type": "text", "id": "cta_text", "label": "Strip button", "default": "Take the Free Assessment" },
    { "type": "text", "id": "cta_url", "label": "Strip button link", "default": "/pages/teacher-moves-assessment" }
  ]
}
{% endschema %}
