<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <div class="site-footer__logo">
          {%- if section.settings.logo != blank -%}
            <a href="/"><img src="{{ section.settings.logo | image_url: width: 280 }}" alt="{{ shop.name }}" width="140" height="38" loading="lazy"></a>
          {%- else -%}
            <a href="/" style="font-family:var(--font-display);font-weight:900;font-size:1.25rem;color:var(--text);">{{ shop.name }}</a>
          {%- endif -%}
        </div>
        <p class="site-footer__tagline">Relocation strategy and contract review for teachers serious about moving internationally. Built by a teacher, for teachers.</p>
      </div>
      <div>
        <h4 class="site-footer__heading">Navigation</h4>
        <ul class="site-footer__links">
          <li><a href="/">Home</a></li>
          <li><a href="/pages/about">About</a></li>
          <li><a href="/collections/all">Products</a></li>
          <li><a href="/pages/coaching">Coaching</a></li>
          <li><a href="/blogs/news">Blog</a></li>
        </ul>
      </div>
      <div>
        <h4 class="site-footer__heading">Legal</h4>
        <ul class="site-footer__links">
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <p>Disclaimer: Some links on this website are affiliate links. I may earn a small commission at no additional cost to you.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" }
  ]
}
{% endschema %}
