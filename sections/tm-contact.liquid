<section class="tm-section" style="padding-top:64px">
  <div class="tm-container tm-split tm-split--top">
    <div class="tm-stack tm-stack--lg">
      <h1 class="tm-h1" style="font-size:clamp(2rem,1.4rem + 2vw,2.9rem)">{{ section.settings.heading }}</h1>
      <div class="tm-rte tm-lead" style="max-width:none">{{ section.settings.text }}</div>
      <p class="tm-body"><a class="tm-link" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
      <p class="tm-small">{{ section.settings.response }}</p>
    </div>
    {%- form 'contact', id: 'tm-contact-form', class: 'tm-form tm-card' -%}
      {%- if form.posted_successfully? -%}
        <p class="tm-form-msg tm-form-msg--ok" role="status">Thanks, your message has been sent. We'll reply by email.</p>
      {%- else -%}
        {%- if form.errors -%}<div class="tm-form-msg tm-form-msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="tm-field"><label for="tc-name">Name</label><input id="tc-name" name="contact[name]" autocomplete="name"></div>
        <div class="tm-field"><label for="tc-email">Email</label><input id="tc-email" type="email" name="contact[email]" autocomplete="email" required></div>
        <div class="tm-field"><label for="tc-msg">How can we help?</label><textarea id="tc-msg" name="contact[body]" required></textarea></div>
        <div><button type="submit" class="tm-btn tm-btn--primary">Send Message</button></div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "TM contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Teacher Moves" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about a resource, a purchase or which service fits your situation? Send a message and a real person will reply.</p>" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@expatteacherslounge.com" },
    { "type": "text", "id": "response", "label": "Response time", "default": "We aim to reply within 24 to 48 hours, Monday to Friday." }
  ]
}
{% endschema %}
