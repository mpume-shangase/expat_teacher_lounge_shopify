<section class="tm-section{% if section.settings.style == 'navy' %} tm-section--navy{% elsif section.settings.style == 'mist' %} tm-section--mist{% endif %}">
  <div class="tm-container tm-container--narrow tm-stack tm-stack--lg tm-center" style="align-items:center">
    <h2 class="tm-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    {%- assign p_style = 'primary' -%}{%- assign s_style = 'secondary' -%}
    {%- if section.settings.style == 'navy' -%}{%- assign p_style = 'light' -%}{%- assign s_style = 'ghost-light' -%}{%- endif -%}
    <div class="tm-row tm-row--stack-mobile" style="justify-content:center">
      {%- if section.settings.buy_product != blank -%}
        {% render 'tm-buy-form', product: section.settings.buy_product, label: section.settings.primary_label, style: p_style, form_id: 'tm-cta-buy' %}
      {%- else -%}
        {% render 'tm-button', label: section.settings.primary_label, url: section.settings.primary_url, style: p_style %}
      {%- endif -%}
      {% render 'tm-button', label: section.settings.secondary_label, url: section.settings.secondary_url, style: s_style %}
    </div>
    {%- if section.settings.note != blank -%}<p class="tm-small">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "TM call to action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure where to start?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Start with the community, explore your options, and take your next step when you're ready." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Join Teacher Moves Free" },
    { "type": "text", "id": "primary_url", "label": "Primary link", "default": "https://www.skool.com/expat-teachers-lounge-9615/about" },
    { "type": "product", "id": "buy_product", "label": "Buy product (primary button goes straight to checkout)" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Explore My Canada Pathway" },
    { "type": "text", "id": "secondary_url", "label": "Secondary link", "default": "/pages/canada-teacher-pathway" },
    { "type": "text", "id": "note", "label": "Small note" },
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }, { "value": "navy", "label": "Navy" }] }
  ],
  "presets": [{ "name": "TM call to action" }]
}
{% endschema %}
