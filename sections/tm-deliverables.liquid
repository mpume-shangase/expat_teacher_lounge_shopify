<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-heading-block">
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="tm-split">
      <ul class="tm-grid tm-grid--2" style="list-style:none;margin:0;padding:0;gap:14px">
        {%- for block in section.blocks -%}
          <li class="tm-card{% if block.settings.highlight %} tm-card--featured{% endif %}" style="padding:20px;gap:6px" {{ block.shopify_attributes }}>
            <h3 class="tm-h4">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="tm-small">{{ block.settings.text }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="tm-reveal">
        <div class="tm-report-stack">
          <div class="tm-report-stack__cover">{% render 'tm-mockup', type: 'cover' %}</div>
          <div class="tm-report-stack__a">{% render 'tm-mockup', type: 'readiness' %}</div>
          <div class="tm-report-stack__b">{% render 'tm-mockup', type: 'checklist' %}</div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM deliverables",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you receive" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "style", "label": "Background", "default": "mist", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [{ "type": "item", "name": "Deliverable", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Deliverable" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "highlight", "label": "Highlight", "default": false } ] }],
  "presets": [{ "name": "TM deliverables", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
