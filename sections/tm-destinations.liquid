<section class="tm-section{% if section.settings.flush_top %} tm-section--flush-top{% endif %}">
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-heading-block">
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- assign dcols = 5 -%}{%- if section.blocks.size == 6 or section.blocks.size == 3 -%}{%- assign dcols = 3 -%}{%- elsif section.blocks.size == 4 or section.blocks.size == 8 -%}{%- assign dcols = 4 -%}{%- endif -%}
    <div class="tm-grid tm-grid--{{ dcols }} tm-dest-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" class="tm-dest tm-reveal" {{ block.shopify_attributes }}>{%- else -%}<div class="tm-dest tm-reveal" {{ block.shopify_attributes }}>{%- endif -%}
          <div class="tm-dest__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 220px, 50vw', alt: '' }}
            {%- else -%}
              <span class="tm-dest__fallback" aria-hidden="true">{{ block.settings.name }}</span>
            {%- endif -%}
          </div>
          <span class="tm-dest__name">{{ block.settings.name }}{% if block.settings.url != blank %}<span aria-hidden="true">&rarr;</span>{% endif %}</span>
          {%- if block.settings.note != blank -%}<span class="tm-dest__note">{{ block.settings.note }}</span>{%- endif -%}
        {%- if block.settings.url != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM destinations",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where will you teach next?" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top spacing", "default": true }
  ],
  "blocks": [{ "type": "destination", "name": "Destination", "settings": [
    { "type": "text", "id": "name", "label": "Name", "default": "Canada" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "url", "label": "Link (leave empty if no page exists)" },
    { "type": "text", "id": "note", "label": "Short note" } ] }],
  "presets": [{ "name": "TM destinations", "blocks": [{ "type": "destination" }] }]
}
{% endschema %}
