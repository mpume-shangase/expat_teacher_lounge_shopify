<section class="tm-section tm-section--mist"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="tm-container tm-split">
    <div class="tm-stack tm-stack--lg">
      {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.product_name != blank -%}
        <div class="tm-row" style="gap:12px;align-items:baseline"><span class="tm-h3">{{ section.settings.product_name }}</span>{%- if section.settings.price != blank -%}<span class="tm-price" style="font-size:1.6rem">{{ section.settings.price }}</span>{%- endif -%}</div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="tm-row" style="gap:8px">
          {%- for block in section.blocks -%}<span class="tm-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>{%- endfor -%}
        </div>
      {%- endif -%}
      <div class="tm-row tm-row--stack-mobile" style="gap:22px">
        {% render 'tm-button', label: section.settings.primary_label, url: section.settings.primary_url, style: 'primary' %}
        {% render 'tm-button', label: section.settings.link_label, url: section.settings.link_url, style: 'link' %}
      </div>
    </div>
    <div class="tm-reveal">
      <div class="tm-report-stack">
        <div class="tm-report-stack__cover">{% render 'tm-mockup', type: 'cover' %}</div>
        <div class="tm-report-stack__a">{% render 'tm-mockup', type: 'readiness', compact: true %}</div>
        <div class="tm-report-stack__b">{% render 'tm-mockup', type: 'roadmap' %}</div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM flagship feature",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Flagship" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thinking about teaching in Canada?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "You shouldn't have to piece together your pathway from dozens of websites." },
    { "type": "text", "id": "product_name", "label": "Offer name", "default": "Canada Teacher Pathway Assessment" },
    { "type": "text", "id": "price", "label": "Price", "default": "$197" },
    { "type": "text", "id": "primary_label", "label": "Button label", "default": "Start My Canada Pathway" },
    { "type": "text", "id": "primary_url", "label": "Button link", "default": "/pages/canada-teacher-pathway" },
    { "type": "text", "id": "link_label", "label": "Text link label", "default": "See how it works" },
    { "type": "text", "id": "link_url", "label": "Text link", "default": "/pages/canada-teacher-pathway#how-it-works" }
  ],
  "blocks": [{ "type": "feature", "name": "Feature label", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Document checklist" }] }],
  "presets": [{ "name": "TM flagship feature" }]
}
{% endschema %}
