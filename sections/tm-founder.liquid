<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}">
  <div class="tm-container tm-split">
    <div class="tm-media tm-reveal" style="aspect-ratio:4/5;max-width:460px;width:100%">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(min-width: 990px) 460px, 100vw', alt: section.settings.image_alt }}
      {%- else -%}
        <img src="{{ section.settings.fallback_asset | asset_img_url: '900x' }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="900" height="1125">
      {%- endif -%}
    </div>
    <div class="tm-stack tm-stack--lg">
      {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      <div class="tm-rte tm-body">{{ section.settings.text }}</div>
      {%- if section.settings.closing != blank -%}<p class="tm-h3" style="font-family:var(--tm-font-display);font-weight:500;color:var(--tm-navy)">{{ section.settings.closing }}</p>{%- endif -%}
      <div class="tm-row">{% render 'tm-button', label: section.settings.link_label, url: section.settings.link_url, style: 'link' %}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM founder",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder photo" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback theme image file", "default": "Edwina_delivering_a_presentation.png" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "Mpume (Edwina) Shangase presenting to educators" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Teacher Moves exists" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built from real international teaching experience." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Founder Mpume (Edwina) Shangase taught in South Africa, the United Kingdom and Qatar before being recruited to teach in New Brunswick. Every move meant new certification rules, new contracts and new systems, usually learned the hard way.</p><p>Teachers kept asking the same questions: where do I start, which documents matter, is this offer fair? Teacher Moves brings those answers into one place.</p>" },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "Teacher Moves exists to make the next move clearer for teachers coming behind us." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "About Teacher Moves" },
    { "type": "text", "id": "link_url", "label": "Link", "default": "/pages/about" },
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "presets": [{ "name": "TM founder" }]
}
{% endschema %}
