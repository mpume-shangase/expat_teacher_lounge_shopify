<section class="tm-section" id="tm-hero-{{ section.id }}" style="padding-top:{{ section.settings.pad_top }}px"{% if section.settings.sticky_trigger %} data-tm-sticky-trigger{% endif %}>
  <div class="tm-container{% if section.settings.visual != 'none' %} tm-split{% else %} tm-container--narrow{% endif %}">
    <div class="tm-stack tm-stack--lg">
      {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="tm-h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.price_text != blank -%}<p class="tm-price">{{ section.settings.price_text }}</p>{%- endif -%}
      <div class="tm-row tm-row--stack-mobile">
        {%- if section.settings.buy_product != blank -%}
          {% render 'tm-buy-form', product: section.settings.buy_product, label: section.settings.primary_label, style: 'primary', form_id: 'tm-hero-buy' %}
        {%- else -%}
          {% render 'tm-button', label: section.settings.primary_label, url: section.settings.primary_url, style: 'primary' %}
        {%- endif -%}
        {% render 'tm-button', label: section.settings.secondary_label, url: section.settings.secondary_url, style: 'secondary' %}
      </div>
      {%- if section.settings.note != blank -%}<p class="tm-small">{{ section.settings.note }}</p>{%- endif -%}
    </div>
    <div>
      {%- case section.settings.visual -%}
        {%- when 'platform' -%}
          <div class="tm-hero-visual">
            <div class="tm-hero-visual__profile">{% render 'tm-mockup', type: 'profile' %}</div>
            <div class="tm-hero-visual__score">{% render 'tm-mockup', type: 'readiness', compact: true %}</div>
            {% render 'tm-mockup', type: 'path' %}
          </div>
        {%- when 'report' -%}
          <div class="tm-report-stack">
            <div class="tm-report-stack__cover">{% render 'tm-mockup', type: 'cover' %}</div>
            <div class="tm-report-stack__a">{% render 'tm-mockup', type: 'checklist' %}</div>
            <div class="tm-report-stack__b">{% render 'tm-mockup', type: 'roadmap' %}</div>
          </div>
        {%- when 'image' -%}
          {%- if section.settings.image != blank -%}
            <div class="tm-media" style="aspect-ratio:4/5;max-width:480px;margin-left:auto">{{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 480px, 100vw', widths: '400, 700, 1100', alt: section.settings.image.alt }}</div>
          {%- elsif section.settings.fallback_asset != blank -%}
            <div class="tm-media" style="aspect-ratio:4/5;max-width:480px;margin-left:auto"><img src="{{ section.settings.fallback_asset | asset_img_url: '960x' }}" alt="{{ section.settings.image_alt | escape }}" width="960" height="1200" loading="eager" style="object-fit:cover"></div>
          {%- endif -%}
      {%- endcase -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TM hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Teacher career and mobility" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make your next teacher move with confidence." },
    { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Teacher Moves helps educators navigate international careers, certification, relocation and contracts with greater clarity." },
    { "type": "text", "id": "price_text", "label": "Price line (optional)" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Join the Free Community" },
    { "type": "text", "id": "primary_url", "label": "Primary button link", "default": "https://www.skool.com/expat-teachers-lounge-9615/about" },
    { "type": "product", "id": "buy_product", "label": "Buy product (primary button goes straight to checkout)" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore My Canada Pathway" },
    { "type": "text", "id": "secondary_url", "label": "Secondary button link", "default": "/pages/canada-teacher-pathway" },
    { "type": "text", "id": "note", "label": "Small note under buttons" },
    { "type": "select", "id": "visual", "label": "Visual", "default": "platform", "options": [
      { "value": "platform", "label": "Profile, readiness and pathway" },
      { "value": "report", "label": "Canada Pathway Report stack" },
      { "value": "image", "label": "Image" },
      { "value": "none", "label": "None" } ] },
    { "type": "image_picker", "id": "image", "label": "Image (when Visual = Image)" },
    { "type": "text", "id": "fallback_asset", "label": "Theme image file used when no image is picked" },
    { "type": "text", "id": "image_alt", "label": "Image description" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 24, "max": 120, "step": 8, "unit": "px", "default": 80 },
    { "type": "checkbox", "id": "sticky_trigger", "label": "Show the mobile sticky button after this section", "default": false }
  ],
  "presets": [{ "name": "TM hero" }]
}
{% endschema %}
