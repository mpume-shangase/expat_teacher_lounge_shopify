{%- assign b = blogs[section.settings.blog] | default: blogs.news -%}
<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}">
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-row" style="justify-content:space-between;align-items:flex-end">
      <div class="tm-heading-block">
        <h2 class="tm-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {% render 'tm-button', label: section.settings.link_label, url: b.url, style: 'link' %}
    </div>
    <div class="tm-grid tm-grid--3">
      {%- for article in b.articles limit: section.settings.count -%}
        {%- if section.settings.tag == blank or article.tags contains section.settings.tag -%}
        <a href="{{ article.url }}" class="tm-card tm-card-link tm-reveal" style="padding:0;overflow:hidden">
          <div class="tm-card__media" style="border-radius:0">
            {%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', sizes: '(min-width: 990px) 380px, 100vw', alt: '' }}{%- endif -%}
          </div>
          <div style="padding:22px;display:flex;flex-direction:column;gap:8px">
            {%- if article.tags.size > 0 -%}<span class="tm-eyebrow" style="font-size:.7rem">{{ article.tags.first }}</span>{%- endif -%}
            <h3 class="tm-h4">{{ article.title }}</h3>
            <span class="tm-small">{{ article.published_at | date: '%B %-d, %Y' }}</span>
          </div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM insights",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Teacher Moves insights" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "count", "label": "Posts", "min": 3, "max": 9, "step": 3, "default": 3 },
    { "type": "text", "id": "tag", "label": "Only show posts with this tag (optional)" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore All Insights" },
    { "type": "select", "id": "style", "label": "Background", "default": "mist", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "presets": [{ "name": "TM insights" }]
}
{% endschema %}
