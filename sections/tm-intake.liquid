<section class="tm-section" style="padding-top:56px">
  <div class="tm-container tm-container--narrow tm-stack tm-stack--lg">
    <p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="tm-h1" style="font-size:clamp(2rem,1.4rem + 2vw,2.8rem)">{{ section.settings.heading }}</h1>
    <div class="tm-rte tm-lead" style="max-width:none">{{ section.settings.intro }}</div>

    {%- form 'contact', id: 'tm-intake-form', class: 'tm-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="tm-form-msg tm-form-msg--ok" role="status" tabindex="-1">{{ section.settings.success }}</div>
      {%- else -%}
        {%- if form.errors -%}<div class="tm-form-msg tm-form-msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="contact[Form]" value="Canada Pathway intake">
        <fieldset style="border:0;margin:0;padding:0" class="tm-stack">
          <legend class="tm-h3" style="margin-bottom:12px">About you</legend>
          <div class="tm-form-grid">
            <div class="tm-field"><label for="ti-name">Full name</label><input id="ti-name" name="contact[name]" autocomplete="name" required></div>
            <div class="tm-field"><label for="ti-email">Email used at checkout</label><input id="ti-email" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="tm-field"><label for="ti-order">Order number</label><input id="ti-order" name="contact[Order number]" placeholder="#1234"></div>
            <div class="tm-field"><label for="ti-country">Country you live in now</label><input id="ti-country" name="contact[Current country]" autocomplete="country-name"></div>
          </div>
        </fieldset>
        <fieldset style="border:0;margin:0;padding:0" class="tm-stack">
          <legend class="tm-h3" style="margin-bottom:12px">Your teaching background</legend>
          <div class="tm-form-grid">
            <div class="tm-field"><label for="ti-qual">Highest qualification</label><input id="ti-qual" name="contact[Highest qualification]" placeholder="e.g. B.Ed, PGCE, PGDE"></div>
            <div class="tm-field"><label for="ti-training">Teacher training programme and country</label><input id="ti-training" name="contact[Teacher training]"></div>
            <div class="tm-field"><label for="ti-years">Years of full-time teaching</label><input id="ti-years" name="contact[Years of experience]" inputmode="numeric"></div>
            <div class="tm-field"><label for="ti-grades">Grades or age groups taught</label><input id="ti-grades" name="contact[Grades taught]"></div>
            <div class="tm-field"><label for="ti-subjects">Subjects taught</label><input id="ti-subjects" name="contact[Subjects]"></div>
            <div class="tm-field"><label for="ti-licence">Current teaching licence or registration (and where)</label><input id="ti-licence" name="contact[Licence or registration]"></div>
          </div>
        </fieldset>
        <fieldset style="border:0;margin:0;padding:0" class="tm-stack">
          <legend class="tm-h3" style="margin-bottom:12px">Your Canada plans</legend>
          <div class="tm-form-grid">
            <div class="tm-field"><label for="ti-prov">Provinces or territories you're considering</label><input id="ti-prov" name="contact[Target provinces]" placeholder="e.g. New Brunswick, Ontario, not sure yet"></div>
            <div class="tm-field"><label for="ti-time">When would you like to start teaching in Canada?</label>
              <select id="ti-time" name="contact[Timeline]"><option value="">Choose one</option><option>Within 6 months</option><option>6 to 12 months</option><option>12 to 24 months</option><option>Not sure yet</option></select></div>
            <div class="tm-field"><label for="ti-docs">Documents you already have</label><input id="ti-docs" name="contact[Documents ready]" placeholder="e.g. degree, transcripts, credential evaluation"></div>
            <div class="tm-field"><label for="ti-lang">Language of instruction you can teach in</label><input id="ti-lang" name="contact[Teaching language]" placeholder="English, French, both"></div>
          </div>
          <div class="tm-field"><label for="ti-goals">Your career goals and biggest question</label><textarea id="ti-goals" name="contact[Goals and questions]"></textarea></div>
        </fieldset>
        <div class="tm-callout">{{ section.settings.documents }}</div>
        <div class="tm-field" style="flex-direction:row;gap:10px;align-items:flex-start">
          <input type="checkbox" id="ti-consent" name="contact[Consent]" value="Yes" required style="width:20px;height:20px;margin-top:2px;flex:0 0 auto">
          <label for="ti-consent" style="font-weight:400">{{ section.settings.consent | remove: '<p>' | remove: '</p>' }}</label>
        </div>
        <div><button type="submit" class="tm-btn tm-btn--primary">{{ section.settings.button }}</button></div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "TM Canada intake form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Canada Teacher Pathway Assessment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Canada Pathway intake" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>This takes about 15 minutes. Your assessment starts once your intake and documents are complete, and your report is normally delivered within 5 business days after that.</p>" },
    { "type": "richtext", "id": "documents", "label": "Document instructions", "default": "<p><strong>Supporting documents:</strong> after you submit this form, email copies of your degree certificate, transcripts, teaching licence or registration and any credential evaluation to <a href=\"mailto:info@expatteacherslounge.com\">info@expatteacherslounge.com</a> with your order number in the subject line. Please don't send passports or financial documents.</p>" },
    { "type": "richtext", "id": "consent", "label": "Consent text", "default": "<p>I agree that Teacher Moves may use this information to prepare my assessment, as described in the <a href=\"/policies/privacy-policy\">privacy policy</a>.</p>" },
    { "type": "text", "id": "button", "label": "Button", "default": "Submit My Intake" },
    { "type": "textarea", "id": "success", "label": "Success message", "default": "Thank you. Your intake has been received. Next step: email your supporting documents with your order number in the subject line. We'll confirm when your review begins." }
  ]
}
{% endschema %}
