<section class="tm-lp tm-lp-section tm-lp-community" id="tm-community">
  <div class="tm-lp-wrap">
    <div class="tm-lp-community__card">
      {%- if section.settings.brand_logo_asset != blank -%}
        <span class="tm-lp-community__mark" aria-hidden="true"><img src="{{ section.settings.brand_logo_asset | asset_url }}" alt="" width="44" height="38" loading="lazy"></span>
      {%- endif -%}
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="tm-lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="tm-lp-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="tm-lp-lede">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_text != blank -%}
        <a class="btn tm-lp-btn-outline" href="{{ section.settings.button_url }}" target="_blank" rel="noopener" data-tm-cta="community">{{ section.settings.button_text }}<span class="sr-only"> (opens in a new tab)</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing community",
  "class": "tm-lp-community-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Teacher Moves community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You don't have to figure it out alone." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join 500+ teachers inside the free Teacher Moves community to ask questions, learn from other educators and keep working on your next move." },
    { "type": "text", "id": "button_text", "label": "Button label", "default": "Join the Free Community" },
    { "type": "text", "id": "button_url", "label": "Button link", "default": "https://www.skool.com/expat-teachers-lounge-9615" },
    { "type": "text", "id": "brand_logo_asset", "label": "Teacher Moves mark (theme asset file)", "default": "tm-mark.svg" }
  ],
  "presets": [{ "name": "Landing community" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
