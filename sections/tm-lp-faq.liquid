<section class="tm-lp tm-lp-section tm-lp-section--soft tm-lp-faq" id="tm-faq">
  <div class="tm-lp-wrap">
    <div class="tm-lp-head">
      {%- if section.settings.eyebrow != blank -%}<span class="tm-lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="tm-lp-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="tm-lp-faq__list">
      {%- for block in section.blocks -%}
        <details class="tm-lp-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="tm-lp-faq__icon" aria-hidden="true"></span></summary>
          <div class="tm-lp-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Landing FAQ",
  "class": "tm-lp-faq-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you start" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is the assessment really free?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Landing FAQ" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
