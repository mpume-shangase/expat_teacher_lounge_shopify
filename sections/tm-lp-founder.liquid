<section class="tm-lp tm-lp-section tm-lp-founder" id="tm-founder">
  <div class="tm-lp-wrap tm-lp-founder__grid">
    <figure class="tm-lp-founder__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 420px, 90vw', alt: section.settings.image_alt }}
      {%- else -%}
        <img src="{{ 'Edwina_headshot.png' | file_url }}" alt="{{ section.settings.image_alt | escape }}" width="900" height="900" loading="lazy">
      {%- endif -%}
    </figure>
    <div class="tm-lp-founder__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="tm-lp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="tm-lp-h2">{{ section.settings.heading }}</h2>
      <div class="tm-lp-founder__body">{{ section.settings.body }}</div>
      {%- liquid
        assign creds_joined = section.settings.cred_1 | append: '|' | append: section.settings.cred_2 | append: '|' | append: section.settings.cred_3 | append: '|' | append: section.settings.cred_4
        assign creds = creds_joined | split: '|'
        assign creds_check = creds_joined | remove: '|' | strip
      -%}
      {%- if creds_check != blank -%}
        <ul class="tm-lp-founder__creds">
          {%- for cred in creds -%}
            {%- assign cred_text = cred | strip -%}
            {%- if cred_text != blank -%}
              <li>
                {%- if cred_text == 'Teacher Moves' and section.settings.brand_logo_asset != blank -%}<img src="{{ section.settings.brand_logo_asset | asset_url }}" alt="" width="18" height="16" loading="lazy">{%- endif -%}
                {{ cred_text | escape }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing founder",
  "class": "tm-lp-founder-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Leave blank to use Edwina_headshot.png from Files." },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "Mpume (Edwina) Shangase" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Meet Mpume (Edwina)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hi, I'm Mpume (Edwina) Shangase." },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>I know that an international teaching move isn't just about finding a vacancy. There are qualifications, contracts, family decisions, finances, relocation and the reality of starting again somewhere new.</p><p>Teacher Moves exists to make that process clearer.</p>" },
    { "type": "header", "content": "Credentials" },
    { "type": "text", "id": "cred_1", "label": "Credential 1", "default": "Founder, Expat Teacher's Lounge" },
    { "type": "text", "id": "cred_2", "label": "Credential 2", "default": "International educator" },
    { "type": "text", "id": "cred_3", "label": "Credential 3", "default": "Teacher Moves" },
    { "type": "text", "id": "cred_4", "label": "Credential 4" },
    { "type": "text", "id": "brand_logo_asset", "label": "Teacher Moves mark (theme asset file)", "default": "tm-mark.svg" }
  ],
  "presets": [{ "name": "Landing founder" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
