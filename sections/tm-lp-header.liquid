{%- comment -%}
  Minimal landing-page header for the Start Here page (page.start-here).
  Rendered from layout/theme.liquid in place of the main header, so this page has no site navigation.
{%- endcomment -%}
{{ 'tm-landing.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign logo_src = 'expat_teachers_lounge_logo.png' | file_url
  if section.settings.logo != blank
    assign logo_src = section.settings.logo | image_url: width: 480
  endif
  assign cta_url = section.settings.cta_url | default: '/pages/teacher-moves-assessment'
-%}
<header class="tm-lp tm-lp-header" data-tm-header>
  <div class="tm-lp-wrap tm-lp-header__inner">
    <div class="tm-lp-header__brand">
      <img class="tm-lp-header__logo" src="{{ logo_src }}" alt="Expat Teacher's Lounge" width="158" height="36" loading="eager">
      {%- if section.settings.brand_name != blank -%}
        <span class="tm-lp-header__divider" aria-hidden="true"></span>
        <span class="tm-lp-header__tm">
          <strong>{{ section.settings.brand_name }}</strong>
          {%- if section.settings.brand_sub != blank -%}<span>{{ section.settings.brand_sub }}</span>{%- endif -%}
        </span>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_text != blank -%}
      <a class="btn btn-primary tm-lp-header__cta" href="{{ cta_url }}" data-tm-cta="header">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</header>
<script>
  (function () {
    var body = document.body;
    var chatMode = {{ section.settings.chat_mode | default: 'delay' | json }};
    body.classList.add('tm-lp-page');
    if (chatMode === 'hide' || chatMode === 'delay') body.classList.add('tm-lp-chat-' + chatMode);

    function init() {
      var header = document.querySelector('[data-tm-header]');
      var hero = document.querySelector('[data-tm-hero]');
      var ticking = false;

      function update() {
        ticking = false;
        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
        if (header) header.classList.toggle('is-scrolled', y > 24);
        if (chatMode === 'delay' && !body.classList.contains('tm-lp-chat-ready')) {
          var trigger = hero ? hero.offsetHeight * 0.8 : window.innerHeight * 0.8;
          if (y > trigger) body.classList.add('tm-lp-chat-ready');
        }
      }

      window.addEventListener('scroll', function () {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      }, { passive: true });
      update();

      document.addEventListener('click', function (event) {
        if (!event.target.closest) return;
        var link = event.target.closest('.tm-lp a[href^="#"]');
        if (link) {
          var id = link.getAttribute('href').slice(1);
          var target = id ? document.getElementById(id) : null;
          if (target) {
            event.preventDefault();
            var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
            if (window.history && window.history.replaceState) window.history.replaceState(null, '', '#' + id);
          }
        }
        var cta = event.target.closest('[data-tm-cta]');
        if (cta && window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {
          try {
            window.Shopify.analytics.publish('tm_start_here_click', { location: cta.getAttribute('data-tm-cta'), url: cta.getAttribute('href') });
          } catch (error) {}
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "Landing page header",
  "class": "tm-lp-header-section",
  "settings": [
    { "type": "paragraph", "content": "Used only on the Start Here page. It replaces the site navigation so the page has one clear action." },
    { "type": "image_picker", "id": "logo", "label": "Expat Teacher's Lounge logo", "info": "Leave blank to use the store's existing ETL logo file." },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Teacher Moves" },
    { "type": "text", "id": "brand_sub", "label": "Brand line", "default": "by Expat Teacher's Lounge" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Free Assessment" },
    { "type": "text", "id": "cta_url", "label": "Button link", "default": "/pages/teacher-moves-assessment" },
    {
      "type": "select",
      "id": "chat_mode",
      "label": "Chat bubble",
      "options": [
        { "value": "delay", "label": "Desktop: show after the hero. Mobile: hidden" },
        { "value": "hide", "label": "Hide on this page" },
        { "value": "show", "label": "Show as normal" }
      ],
      "default": "delay"
    }
  ]
}
{% endschema %}
