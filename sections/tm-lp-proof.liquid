{%- liquid
  assign stat_count = 0
  assign quote_count = 0
  for block in section.blocks
    if block.type == 'stat'
      assign stat_count = stat_count | plus: 1
    elsif block.type == 'testimonial' and block.settings.quote != blank
      assign quote_count = quote_count | plus: 1
    endif
  endfor
-%}
<section class="tm-lp tm-lp-section tm-lp-section--soft tm-lp-proof" id="tm-proof">
  <div class="tm-lp-wrap">
    <div class="tm-lp-head">
      <h2 class="tm-lp-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="tm-lp-lede">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    {%- if stat_count > 0 -%}
      <div class="tm-lp-proof__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="tm-lp-stat" {{ block.shopify_attributes }}>
              <span class="tm-lp-stat__value">{{ block.settings.value }}</span>
              <span class="tm-lp-stat__label">{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if quote_count > 0 -%}
      <div class="tm-lp-quotes">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' and block.settings.quote != blank -%}
            <figure class="tm-lp-quote" {{ block.shopify_attributes }}>
              {%- if block.settings.tag != blank -%}<span class="tm-lp-quote__tag">{{ block.settings.tag }}</span>{%- endif -%}
              <blockquote>&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
              <figcaption>
                <strong>{{ block.settings.name }}</strong>
                {%- if block.settings.detail != blank -%}{{ block.settings.detail }}{%- endif -%}
              </figcaption>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Landing proof",
  "class": "tm-lp-proof-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Teachers are already making their moves." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "paragraph", "content": "Only add real testimonials from members or clients, with their permission. Testimonial cards stay hidden until you add one." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Number",
      "settings": [
        { "type": "text", "id": "value", "label": "Number", "default": "500+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Teacher Moves members" }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "tag", "label": "Outcome label", "info": "For example: Canada certification, Interview, Contract review" },
        { "type": "textarea", "id": "quote", "label": "Quote (real member or client only)" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "detail", "label": "Detail", "info": "For example: Teacher, moving from Qatar to Nova Scotia" }
      ]
    }
  ],
  "presets": [{ "name": "Landing proof" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
