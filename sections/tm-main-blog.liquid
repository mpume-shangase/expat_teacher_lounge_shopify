{%- paginate blog.articles by 9 -%}
<section class="tm-section" style="padding-top:56px">
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-heading-block">
      <p class="tm-eyebrow">Insights</p>
      <h1 class="tm-h1" style="font-size:clamp(2rem,1.4rem + 2vw,2.9rem)">{{ section.settings.heading }}</h1>
      <p class="tm-lead">{{ section.settings.text }}</p>
    </div>
    {%- if blog.all_tags.size > 0 -%}
      <nav class="tm-tabs" aria-label="Filter by topic">
        <a href="{{ blog.url }}"{% unless current_tags %} aria-current="page" style="border-color:var(--tm-navy);color:var(--tm-navy)"{% endunless %}>All</a>
        {%- for tag in blog.all_tags limit: section.settings.tag_limit -%}
          {%- assign active = false -%}{%- if current_tags contains tag -%}{%- assign active = true -%}{%- endif -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}"{% if active %} aria-current="page" style="border-color:var(--tm-navy);color:var(--tm-navy)"{% endif %}>{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
    <div class="tm-grid tm-grid--3">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="tm-card tm-card-link" style="padding:0;overflow:hidden">
          <div class="tm-card__media" style="border-radius:0">{%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', sizes: '(min-width: 990px) 380px, 100vw', alt: '' }}{%- endif -%}</div>
          <div style="padding:22px;display:flex;flex-direction:column;gap:8px">
            {%- if article.tags.size > 0 -%}<span class="tm-eyebrow" style="font-size:.7rem">{{ article.tags.first }}</span>{%- endif -%}
            <h2 class="tm-h4">{{ article.title }}</h2>
            <span class="tm-small">{{ article.published_at | date: '%B %-d, %Y' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="tm-row" aria-label="Pagination" style="justify-content:center">{{ paginate | default_pagination }}</nav>{%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "TM blog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Teacher Moves insights" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "First-hand guidance on teaching in Canada, international moves, contracts and career growth." },
    { "type": "range", "id": "tag_limit", "label": "Topics shown", "min": 4, "max": 20, "step": 1, "default": 8 }
  ]
}
{% endschema %}
