{%- paginate collection.products by 24 -%}
<section class="tm-section" style="padding-top:56px">
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-heading-block">
      <p class="tm-eyebrow">Teacher Moves resources</p>
      <h1 class="tm-h1" style="font-size:clamp(2rem,1.4rem + 2vw,2.9rem)">{% if collection.handle == 'all' %}All resources{% else %}{{ collection.title }}{% endif %}</h1>
      {%- if collection.description != blank -%}<div class="tm-rte tm-lead">{{ collection.description }}</div>{%- endif -%}
      <p class="tm-small">Looking for a category? <a class="tm-link" href="/pages/resources">Browse the resource library</a>.</p>
    </div>
    {%- if collection.products.size > 0 -%}
      <ul class="tm-grid tm-grid--4" style="list-style:none;margin:0;padding:0">
        {%- for p in collection.products -%}
          <li>
            <a href="{{ p.url }}" class="tm-product-card">
              <div class="tm-product-card__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 500', sizes: '(min-width: 990px) 270px, 50vw', alt: '' }}{%- endif -%}</div>
              <span class="tm-product-card__title">{{ p.title }}</span>
              <span class="tm-product-card__price">{% if p.price == 0 %}Free{% else %}{{ p.price | money }}{% endif %}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="tm-callout">No resources here yet. <a class="tm-link" href="/pages/resources">See all resources</a>.</p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="tm-row" aria-label="Pagination" style="justify-content:center">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "TM collection" }
{% endschema %}
