<section class="tm-section" style="padding-top:64px">
  <div class="tm-container tm-container--narrow tm-stack tm-stack--lg">
    {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="tm-h1" style="font-size:clamp(2rem,1.4rem + 2vw,2.9rem)">{{ page.title }}</h1>
    <div class="tm-rte tm-body" style="font-size:1.05rem">{{ page.content }}</div>
    {%- if page.handle == 'contact' -%}
      {%- form 'contact', id: 'tm-contact-form', class: 'tm-form tm-card' -%}
        {%- if form.posted_successfully? -%}
          <p class="tm-form-msg tm-form-msg--ok" role="status">Thanks, your message has been sent. We'll reply by email.</p>
        {%- else -%}
          {%- if form.errors -%}<div class="tm-form-msg tm-form-msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <h2 class="tm-h3">Send a message</h2>
          <div class="tm-form-grid">
            <div class="tm-field"><label for="tc-name">Name</label><input id="tc-name" name="contact[name]" autocomplete="name"></div>
            <div class="tm-field"><label for="tc-email">Email</label><input id="tc-email" type="email" name="contact[email]" autocomplete="email" required></div>
          </div>
          <div class="tm-field"><label for="tc-msg">How can we help?</label><textarea id="tc-msg" name="contact[body]" required></textarea></div>
          <div><button type="submit" class="tm-btn tm-btn--primary">Send Message</button></div>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "TM page content",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow" }]
}
{% endschema %}
