{%- liquid
  assign v = product.selected_or_first_available_variant
  assign kind = 'digital'
  if product.price == 0
    assign kind = 'free'
  endif
  if product.tags contains 'coaching' or product.tags contains 'service' or product.handle == 'canada-teacher-pathway-assessment'
    assign kind = 'service'
  endif

  case product.handle
    when 'relocation-strategy-session'
      assign cta = 'Build My Relocation Strategy'
    when 'contract-review-session'
      assign cta = 'Review My Contract'
    when 'canada-teacher-pathway-assessment'
      assign cta = 'Start My Canada Pathway'
    else
      if kind == 'free'
        assign cta = 'Download Free'
      elsif kind == 'service'
        assign cta = 'Continue to Checkout'
      else
        assign cta = 'Get This Resource'
      endif
  endcase

  case kind
    when 'service'
      assign eyebrow = 'Teacher Moves service'
    when 'free'
      assign eyebrow = 'Free resource'
    else
      assign eyebrow = 'Teacher Moves resource'
  endcase
-%}

<section class="tm-section" style="padding-top:48px">
  <div class="tm-container">
    <nav aria-label="Breadcrumb" class="tm-small" style="margin-bottom:28px">
      <a href="/" class="tm-muted" style="text-decoration:none">Home</a> <span aria-hidden="true">/</span>
      {%- if kind == 'service' -%}
        <a href="/pages/services" class="tm-muted" style="text-decoration:none">Services</a>
      {%- else -%}
        <a href="/pages/resources" class="tm-muted" style="text-decoration:none">Resources</a>
      {%- endif -%}
    </nav>
    <div class="tm-split tm-split--top" style="gap:64px">
      <div class="tm-media" style="background:var(--tm-mist);border:1px solid var(--tm-line);padding:24px;box-sizing:border-box">
        {%- if product.featured_image -%}
          {%- assign img_alt = product.featured_image.alt | default: product.title -%}
          {{ product.featured_image | image_url: width: 1100 | image_tag: loading: 'eager', widths: '450, 800, 1100', sizes: '(min-width: 990px) 560px, 100vw', alt: img_alt, style: 'object-fit:contain;aspect-ratio:4/3;border-radius:10px' }}
        {%- else -%}
          <div style="aspect-ratio:4/3">{% render 'tm-mockup', type: 'cover' %}</div>
        {%- endif -%}
      </div>

      <div class="tm-stack tm-stack--lg">
        <p class="tm-eyebrow">{{ eyebrow }}</p>
        <h1 class="tm-h1" style="font-size:clamp(2rem,1.4rem + 2vw,2.75rem)">{{ product.title }}</h1>
        <p class="tm-price">{% if product.price == 0 %}Free{% else %}{{ v.price | money }}{% endif %}</p>

        {%- form 'product', product, id: 'tm-product-form', class: 'tm-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="return_to" value="/checkout">
          <input type="hidden" name="quantity" value="1">
          {%- if product.has_only_default_variant -%}
            <input type="hidden" name="id" value="{{ v.id }}">
          {%- else -%}
            <div class="tm-field">
              <label for="tm-variant">Choose an option</label>
              <select id="tm-variant" name="id">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}"{% if variant == v %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} · {% if variant.available %}{{ variant.price | money }}{% else %}Sold out{% endif %}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          <button type="submit" name="add" class="tm-btn tm-btn--primary tm-btn--block"{% unless v.available %} disabled{% endunless %}>
            {%- if v.available -%}{{ cta }}{%- else -%}Currently unavailable{%- endif -%}
          </button>
        {%- endform -%}

        <ul class="tm-row tm-small" style="list-style:none;margin:0;padding:0;gap:18px">
          <li>Secure checkout</li>
          {%- if kind == 'service' -%}
            <li>Next steps sent by email</li>
          {%- else -%}
            <li>Access details sent by email</li>
          {%- endif -%}
          <li>Questions? <a class="tm-link" href="mailto:info@expatteacherslounge.com">Email us</a></li>
        </ul>

        {%- if kind == 'service' -%}
          <div class="tm-card" style="background:var(--tm-mist);border-color:var(--tm-line)">
            <h2 class="tm-h4">What happens after you buy</h2>
            {%- if product.handle == 'canada-teacher-pathway-assessment' -%}
              <ol class="tm-small" style="margin:0;padding-left:20px;line-height:1.9;color:var(--tm-ink)">
                <li>Your confirmation email includes a link to your structured intake.</li>
                <li>Complete the intake and send the requested documents.</li>
                <li>Your report is normally ready within 5 business days of a complete intake.</li>
                <li>You then book your included 30-minute debrief.</li>
              </ol>
              <a class="tm-link" href="/pages/canada-teacher-pathway">See everything included</a>
            {%- else -%}
              <ol class="tm-small" style="margin:0;padding-left:20px;line-height:1.9;color:var(--tm-ink)">
                <li>Your confirmation email includes your scheduling link.</li>
                <li>Choose a time and answer a few short questions so the session is prepared around you.</li>
                <li>Meet online and leave with clear next steps.</li>
              </ol>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="tm-rte tm-body" style="color:var(--tm-ink)">{{ product.description }}</div>

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}

        <div class="tm-callout">
          {%- if kind == 'service' -%}
            Not sure this is the right service? <a class="tm-link" href="/pages/services">Compare all services</a> or <a class="tm-link" href="https://www.skool.com/expat-teachers-lounge-9615/about" target="_blank" rel="noopener">ask in the free community<span class="tm-sr"> (opens in a new tab)</span></a>.
          {%- else -%}
            Want help applying this to your situation? <a class="tm-link" href="/pages/services">See personalised services</a>.
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TM product",
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
