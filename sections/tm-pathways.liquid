{%- assign cols = section.blocks.size | at_most: 4 | at_least: 2 -%}
<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="tm-container tm-stack tm-stack--xl">
    {%- if section.settings.heading != blank -%}
    <div class="tm-heading-block">
      {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- endif -%}
    <div class="tm-grid tm-grid--{{ cols }}">
      {%- for block in section.blocks -%}
        <div class="tm-card{% if block.settings.featured %} tm-card--featured{% endif %} tm-reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="tm-card__media">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', sizes: '(min-width: 990px) 280px, 100vw', alt: block.settings.image.alt }}</div>
          {%- elsif block.settings.visual != 'none' -%}
            <div style="min-height:150px">{% render 'tm-mockup', type: block.settings.visual, compact: true %}</div>
          {%- endif -%}
          {%- if block.settings.kicker != blank -%}<p class="tm-eyebrow">{{ block.settings.kicker }}</p>{%- endif -%}
          <h3 class="tm-h3">{{ block.settings.title }}</h3>
          {%- if block.settings.price != blank -%}<p class="tm-price" style="font-size:1.6rem">{{ block.settings.price }}</p>{%- endif -%}
          <p class="tm-small tm-card__grow">{{ block.settings.text }}</p>
          {%- assign bstyle = 'secondary' -%}{%- if block.settings.featured -%}{%- assign bstyle = 'primary' -%}{%- endif -%}
          {% render 'tm-button', label: block.settings.button_label, url: block.settings.button_url, style: bstyle, block: true %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM pathway cards",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID (for #links)", "default": "whats-your-next-move" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's your next move?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose where you are in your journey and we'll point you toward the right next step." },
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [{ "type": "card", "name": "Card", "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "title", "label": "Title", "default": "Teach in Canada" },
    { "type": "text", "id": "price", "label": "Price (optional)" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "featured", "label": "Featured (navy border, primary button)", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "select", "id": "visual", "label": "Mockup (if no image)", "default": "none", "options": [
      { "value": "none", "label": "None" }, { "value": "readiness", "label": "Readiness" }, { "value": "roadmap", "label": "90-day roadmap" },
      { "value": "checklist", "label": "Document checklist" }, { "value": "profile", "label": "Profile" } ] } ] }],
  "presets": [{ "name": "TM pathway cards", "blocks": [{ "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
