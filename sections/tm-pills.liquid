<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}">
  <div class="tm-container tm-stack tm-stack--lg">
    <div class="tm-heading-block">
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="tm-row" style="list-style:none;margin:0;padding:0;gap:10px">
      {%- for block in section.blocks -%}<li class="tm-pill" style="min-height:42px;padding:0 18px" {{ block.shopify_attributes }}>{{ block.settings.label }}</li>{%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "TM labels list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we review" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [{ "type": "label", "name": "Label", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Qualifications" }] }],
  "presets": [{ "name": "TM labels list", "blocks": [{ "type": "label" }] }]
}
{% endschema %}
