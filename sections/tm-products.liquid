<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-row" style="justify-content:space-between;align-items:flex-end;gap:24px">
      <div class="tm-heading-block">
        {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="tm-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {% render 'tm-button', label: section.settings.button_label, url: section.settings.button_url, style: 'secondary' %}
    </div>
    <div class="tm-grid tm-grid--4">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <a href="{{ p.url }}" class="tm-product-card tm-reveal" {{ block.shopify_attributes }}>
            <div class="tm-product-card__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 500', sizes: '(min-width: 990px) 270px, 50vw', alt: '' }}{%- endif -%}</div>
            {%- if block.settings.category != blank -%}<span class="tm-eyebrow" style="font-size:.7rem">{{ block.settings.category }}</span>{%- endif -%}
            <span class="tm-product-card__title">{{ p.title }}</span>
            <span class="tm-product-card__price">{% if p.price == 0 %}Free{% else %}{{ p.price | money }}{% endif %}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM curated resources",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Prefer to research at your own pace?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Explore practical Teacher Moves tools, guides and resources designed to help you make informed career and relocation decisions." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore All Resources" },
    { "type": "text", "id": "button_url", "label": "Button link", "default": "/pages/resources" },
    { "type": "select", "id": "style", "label": "Background", "default": "mist", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [{ "type": "product", "name": "Product", "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "category", "label": "Category label" } ] }],
  "presets": [{ "name": "TM curated resources" }]
}
{% endschema %}
