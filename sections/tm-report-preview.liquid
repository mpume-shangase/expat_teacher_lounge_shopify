<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}">
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-heading-block">
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="tm-grid tm-grid--3" style="align-items:stretch">
      <div class="tm-reveal" style="min-height:300px">{% render 'tm-mockup', type: 'cover' %}</div>
      <div class="tm-reveal">{% render 'tm-mockup', type: 'readiness' %}</div>
      <div class="tm-reveal tm-stack">{% render 'tm-mockup', type: 'roadmap' %}{% render 'tm-mockup', type: 'profile' %}</div>
    </div>
    <p class="tm-small">Sample pages with example data. Your report is prepared personally from your intake and documents.</p>
  </div>
</section>
{% schema %}
{
  "name": "TM report preview",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See what your report looks like" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "style", "label": "Background", "default": "mist", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "presets": [{ "name": "TM report preview" }]
}
{% endschema %}
