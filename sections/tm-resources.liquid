<section class="tm-section tm-section--tight" style="padding-top:8px">
  <div class="tm-container tm-stack tm-stack--xl">
    <nav class="tm-tabs" aria-label="Resource categories">
      {%- for block in section.blocks -%}<a href="#{{ block.settings.anchor }}">{{ block.settings.title }}</a>{%- endfor -%}
    </nav>
    {%- for block in section.blocks -%}
      {%- assign c = collections[block.settings.collection] -%}
      <div class="tm-shelf tm-stack tm-stack--lg" id="{{ block.settings.anchor }}" {{ block.shopify_attributes }} style="padding-top:24px;border-top:1px solid var(--tm-line)">
        <div class="tm-row" style="justify-content:space-between;align-items:flex-end;gap:16px">
          <div class="tm-stack" style="gap:8px;max-width:680px">
            <h2 class="tm-h2" style="font-size:1.9rem">{{ block.settings.title }}</h2>
            {%- if block.settings.text != blank -%}<p class="tm-small" style="font-size:1rem">{{ block.settings.text }}</p>{%- endif -%}
          </div>
          {% render 'tm-button', label: block.settings.link_label, url: block.settings.link_url, style: 'link' %}
        </div>
        {%- if c != blank and c.products_count > 0 -%}
          <div class="tm-grid tm-grid--4">
            {%- for p in c.products limit: 8 -%}
              <a href="{{ p.url }}" class="tm-product-card">
                <div class="tm-product-card__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 500', sizes: '(min-width: 990px) 270px, 50vw', alt: '' }}{%- endif -%}</div>
                <span class="tm-product-card__title">{{ p.title }}</span>
                <span class="tm-product-card__price">{% if p.price == 0 %}Free{% else %}{{ p.price | money }}{% endif %}</span>
              </a>
            {%- endfor -%}
          </div>
        {%- elsif block.settings.empty_text != blank -%}
          <div class="tm-callout">{{ block.settings.empty_text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "TM resource library",
  "blocks": [{ "type": "shelf", "name": "Category", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Teach in Canada" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "canada" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "textarea", "id": "empty_text", "label": "Text when the collection is empty" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "text", "id": "link_url", "label": "Link" } ] }],
  "presets": [{ "name": "TM resource library", "blocks": [{ "type": "shelf" }] }]
}
{% endschema %}
