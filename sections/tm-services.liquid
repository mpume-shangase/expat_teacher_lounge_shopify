<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-heading-block">
      {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="tm-grid {% if section.settings.layout == 'detailed' %}tm-grid--3{% else %}tm-grid--featured{% endif %}">
      {%- for block in section.blocks -%}
        <article class="tm-card{% if block.settings.featured %} tm-card--featured{% endif %} tm-reveal"{% if block.settings.anchor != blank %} id="{{ block.settings.anchor }}"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.featured -%}<span class="tm-badge tm-badge--navy" style="align-self:flex-start">Featured</span>{%- endif -%}
          <h3 class="tm-h3">{{ block.settings.title }}</h3>
          <p class="tm-price" style="font-size:1.75rem">{{ block.settings.price }}</p>
          <p class="tm-small">{{ block.settings.text }}</p>
          {%- if block.settings.details != blank -%}<div class="tm-rte tm-small" style="color:var(--tm-ink)">{{ block.settings.details }}</div>{%- endif -%}
          <div class="tm-card__grow"></div>
          {%- assign bstyle = 'secondary' -%}{%- if block.settings.featured -%}{%- assign bstyle = 'primary' -%}{%- endif -%}
          {% render 'tm-button', label: block.settings.button_label, url: block.settings.button_url, style: bstyle, block: true %}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM services",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need more personalised support?" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "featured", "options": [{ "value": "featured", "label": "First card wider" }, { "value": "detailed", "label": "Equal columns" }] },
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "blocks": [{ "type": "service", "name": "Service", "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "title", "label": "Title", "default": "Service" },
    { "type": "text", "id": "price", "label": "Price", "default": "$97" },
    { "type": "textarea", "id": "text", "label": "Short description" },
    { "type": "richtext", "id": "details", "label": "Details (who, problem, what you get, what's next)" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "featured", "label": "Featured", "default": false } ] }],
  "presets": [{ "name": "TM services", "blocks": [{ "type": "service" }] }]
}
{% endschema %}
