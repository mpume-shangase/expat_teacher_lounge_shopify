<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}{% if section.settings.flush_top %} tm-section--flush-top{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="tm-container tm-stack tm-stack--xl">
    <div class="tm-heading-block">
      {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="tm-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- assign n = section.blocks.size | at_most: 4 -%}
    <ol class="tm-steps" style="--tm-steps: {{ n }}; list-style:none; margin:0; padding:0">
      {%- for block in section.blocks -%}
        <li class="tm-step tm-reveal" {{ block.shopify_attributes }}>
          <span class="tm-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="tm-h4">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="tm-small">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.button_label != blank -%}
      <div class="tm-row tm-row--stack-mobile">{% render 'tm-button', label: section.settings.button_label, url: section.settings.button_url, style: 'secondary' %}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "TM steps",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "text", "id": "button_url", "label": "Button link" },
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] },
    { "type": "checkbox", "id": "flush_top", "label": "Remove top spacing", "default": false }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Step" },
    { "type": "textarea", "id": "text", "label": "Text" } ] }],
  "presets": [{ "name": "TM steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
