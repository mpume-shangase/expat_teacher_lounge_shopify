<section class="tm-section{% if section.settings.style == 'mist' %} tm-section--mist{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="tm-container tm-split tm-split--top">
    <div class="tm-stack">
      {%- if section.settings.eyebrow != blank -%}<p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tm-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="tm-stack tm-stack--lg">
      <div class="tm-rte tm-body" style="font-size:1.07rem">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <div class="tm-row tm-row--stack-mobile">{% render 'tm-button', label: section.settings.button_label, url: section.settings.button_url, style: section.settings.button_style %}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TM heading and text",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_url", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "secondary", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "link", "label": "Text link" }] },
    { "type": "select", "id": "style", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "mist", "label": "Mist" }] }
  ],
  "presets": [{ "name": "TM heading and text" }]
}
{% endschema %}
