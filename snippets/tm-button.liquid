{%- comment -%}
  Renders one button or text link with a fixed destination.
  Params: label, url, style ('primary' | 'secondary' | 'light' | 'ghost-light' | 'link'), size ('sm'), block (true), extra_class
  External URLs (http/https not on this shop) open in a new tab with an arrow icon and screen-reader notice.
{%- endcomment -%}
{%- liquid
  assign btn_style = style | default: 'primary'
  assign is_external = false
  if url contains 'http://' or url contains 'https://'
    assign is_external = true
    if url contains request.host
      assign is_external = false
    endif
  endif
  if btn_style == 'link'
    assign cls = 'tm-link'
  else
    assign cls = 'tm-btn tm-btn--' | append: btn_style
    if size == 'sm'
      assign cls = cls | append: ' tm-btn--sm'
    endif
    if block
      assign cls = cls | append: ' tm-btn--block'
    endif
  endif
  if extra_class != blank
    assign cls = cls | append: ' ' | append: extra_class
  endif
-%}
{%- if label != blank and url != blank -%}
<a href="{{ url }}" class="{{ cls }}"{% if is_external %} target="_blank" rel="noopener"{% endif %}>{{ label }}{% if is_external %}<svg class="tm-btn__ext" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M5 3h6v6M11 3L3 11" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="tm-sr"> (opens in a new tab)</span>{% endif %}</a>
{%- endif -%}
