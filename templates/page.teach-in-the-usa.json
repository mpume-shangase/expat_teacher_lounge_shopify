      "type": "etl-faq",
      "settings": {
        "anchor": "faq",
        "title_prefix": "Frequently asked",
        "title_italic": "questions.",
        "tint": true
      },
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Can I teach in the USA on a J-1 without a teaching degree?",
            "answer": "<p>You need at least the equivalent of a U.S. bachelor's degree in education, or in the subject you will teach, and you must be qualified to teach in your home country. A degree in your subject can work, but the teaching qualification is still needed.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "How many years of teaching experience do I need?",
            "answer": "<p>At least two years of full-time teaching. If you're not teaching when you apply, those two years must be within the last eight years and you need an advanced degree finished within 12 months of applying.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "How long can I stay on the J-1 teacher program?",
            "answer": "<p>Up to three years. Your school can ask your sponsor for a one- or two-year extension, so most teachers can stay up to five years in total. Extensions aren't automatic.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Do I apply to the government or to a school?",
            "answer": "<p>Neither, at first. You apply to a sponsor the State Department has approved for the Teacher category. The sponsor screens you, helps match you with a school and issues your DS-2019.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Can my family come with me?",
            "answer": "<p>Usually, yes. Your spouse and unmarried children under 21 can come on J-2 visas, each with their own DS-2019. Ask your sponsor about its family rules early.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "Can my spouse work in the USA?",
            "answer": "<p>A J-2 spouse can apply to USCIS for work permission with Form I-765. They can't work until it's approved, and their income can't be used to support you.</p>"
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "Is the J-1 a route to a green card?",
            "answer": "<p>Not directly. It's a cultural exchange and you're expected to go home. If the 212(e) two-year home residency rule applies to you, you can't get a green card or an H, L or K visa until you've spent two years in your home country.</p>"
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "Can I do the J-1 teacher program more than once?",
            "answer": "<p>Yes, if you've lived outside the U.S. for at least two years since your last J-1 teacher program and you still meet the requirements.</p>"
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "question": "Is the starter guide really free?",
            "answer": "<p>Yes. You check out at $0 and the guide arrives by email. The J-1 Teacher Application Guide ($7.99) is the full step-by-step version for when you're ready to apply.</p>"
          }
        }
